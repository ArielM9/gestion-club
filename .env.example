# Database
DATABASE_URL="postgresql://user:password@localhost:5432/victorianos"
PRISMA_CLIENT_ENGINE_TYPE='library'

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-secret-here"

# S3/MinIO
S3_ENDPOINT="http://192.168.1.133:9000"
S3_REGION="us-east-1"
S3_BUCKET="club-files"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"

# Demo mode
# Activar con NEXT_PUBLIC_IS_DEMO=true en despliegues de demo
# (también se puede usar IS_DEMO=true solo en el servidor).
NEXT_PUBLIC_IS_DEMO="false"
IS_DEMO="false"
# Contraseña del usuario admin@demo.local. Se crea vía seed:demo.
# NO COMMITEAR el valor real; usar un secret store en producción.
DEMO_ADMIN_PASSWORD=""