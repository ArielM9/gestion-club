# ========================================
# CONFIGURACIÓN - Victorianos Gestión
# ========================================

# ---------
# DATABASE
# ---------
DATABASE_URL="postgresql://user:password@host:5432/database"
# Forzar motor de Prisma (library = sin WebAssembly, requerido para Next.js)
PRISMA_CLIENT_ENGINE_TYPE=library

# ----------------
# AUTH (Better Auth)
# ----------------
BETTER_AUTH_URL="https://tu-dominio.com"
# Genera uno nuevo: openssl rand -base64 32
BETTER_AUTH_SECRET="genera-un-secret-nuevo-aqui"

# ------------
# MINIO / S3
# ------------
S3_ENDPOINT="http://192.168.1.133:9000"
S3_REGION="us-east-1"
S3_BUCKET="club-files"
S3_ACCESS_KEY="tu-access-key"
S3_SECRET_KEY="tu-secret-key"

# -------------------------
# CONFIGURACIÓN DEMO
# -------------------------
# Establecer a 'true' para bloquear el registro de nuevos usuarios
# Útil para demos públicas
BLOCK_REGISTER=false
