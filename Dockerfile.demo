# syntax=docker/dockerfile:1.4
# Demo image: extends the production Dockerfile with a seed step that runs on
# every container start. The seed is idempotent, so re-running against an
# existing demo database is safe.

FROM node:20-slim AS base

RUN apt-get update && apt-get install -y openssl curl gnupg ca-certificates && rm -rf /var/lib/apt/lists/*

RUN curl -o- -sL https://dl.yarnpkg.com/debian/pubkey.gpg | apt-key add - && \
    echo "deb https://dl.yarnpkg.com/debian/ stable main" | tee /etc/apt/sources.list.d/yarn.list && \
    apt-get update && apt-get install -y yarn && rm -rf /var/lib/apt/lists/*

# ----- deps -----
FROM base AS deps
WORKDIR /app

COPY package.json yarn.lock* ./
COPY turbo.json ./
COPY packages ./packages
RUN yarn install --ignore-scripts --ignore-engines

# ----- prisma generate -----
FROM base AS prisma
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json yarn.lock* ./
COPY turbo.json ./
COPY packages ./packages
COPY .env* ./
RUN npx prisma generate --schema=packages/db/schema.prisma

# ----- build -----
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=prisma /app/packages/generated/prisma ./packages/generated/prisma
COPY turbo.json ./
COPY package.json yarn.lock* ./
COPY tsconfig.json ./
COPY next.config.ts ./
COPY tailwind.config.ts ./
COPY postcss.config.mjs ./
COPY .env* ./
COPY app ./app
COPY components ./components
COPY lib ./lib
COPY packages ./packages
COPY scripts ./scripts

ENV NEXT_TURBOPACK=0
ENV NEXT_USE_WEBPACK=1
RUN yarn build

# ----- runtime -----
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# App artefacts
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/packages ./packages
COPY --from=builder --chown=nextjs:nodejs /app/scripts ./scripts

# Demo env (mounted by compose, but also baked in as fallback)
COPY .env.demo ./.env

# Entrypoint that runs db push + seed before starting the server
COPY --chown=nextjs:nodejs <<'EOF' /app/entrypoint.sh
#!/bin/sh
set -e
echo "[demo] pushing schema..."
export $(grep -v '^#' .env | xargs)
npx prisma db push --schema=packages/db/schema.prisma
echo "[demo] seeding..."
npx tsx scripts/seed-demo.ts || echo "[demo] seed failed (continuing)"
echo "[demo] starting app..."
exec node node_modules/next/dist/bin/next start
EOF
RUN chmod +x /app/entrypoint.sh

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["/app/entrypoint.sh"]
