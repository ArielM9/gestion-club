IS_DEMO=true
NEXT_PUBLIC_IS_DEMO=true

# Database — separate instance for the demo
DATABASE_URL=postgresql://demo:demo@postgres:5432/victorianos_demo
PRISMA_CLIENT_ENGINE_TYPE=library

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=demo-secret-not-for-production-only

# S3 / MinIO — isolated bucket for the demo
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=club-files
S3_ACCESS_KEY=demo
S3_SECRET_KEY=demo123456

# MinIO admin (used by the bucket init step)
MINIO_ROOT_USER=demo
MINIO_ROOT_PASSWORD=demo123456
