generator client {
  provider = "prisma-client"
  output   = "../app/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(cuid()) // Mantenemos tu CUID
  name               String? // Better Auth lo quiere, tú ya lo tenías opcional
  email              String     @unique // Better Auth lo exige único para login
  emailVerified      Boolean    @default(false) // Requisito de BA
  image              String?
  username           String?    @unique // Tu campo original
  role               Role       @default(COLABORADOR) // Tu Enum original
  status             UserStatus @default(PENDING) // Tu Enum original
  mustChangePassword Boolean    @default(false) // Forzar cambio de contraseña en primer login
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relaciones de Better Auth
  sessions Session[]
  accounts Account[]

  // Tus relaciones originales (NO LAS TOQUES, están bien así)
  abonosAprobados Abono[]     @relation("Aprobador")
  logs            Log[]
  documentos      Documento[]
  ventas          Venta[]

  @@index([role, status])
  @@map("user") // Esto es importante para que BA encuentre la tabla
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Socio {
  id                         String               @id @default(cuid())
  nombre                     String
  apellidos                  String
  mote                       String?
  dni                        String               @unique
  sexo                       String // "M" o "F" - obligatorio para asignar categoría
  fechaNacimiento            DateTime
  nacionalidad               String               @default("Española")
  fotoUrl                    String?
  urlDniFrontal              String?
  telefono                   String?
  email                      String?
  direccion                  String?
  codigoPostal               String?
  localidad                  String?
  cuentaBancaria             String?
  activo                     Boolean              @default(true)
  deudaPendiente             Float                @default(0) // Deuda acumulada de temporadas anteriores
  // Nuevos campos
  nombreTutor                String?
  dniTutor                   String?
  telefonoTutor              String?
  observaciones              String?
  tallaRopa                  String? // Ej: "L", "XL", "Talla 12"
  rgpdFirmado                Boolean              @default(false)
  urlDocumentoRgpd           String? // Para cuando implementemos la subida del PDF escaneado
  declaracionResponsable     Boolean              @default(false)
  exoneracionResponsabilidad Boolean              @default(false)
  declaracionExtranjera      Boolean              @default(false)
  abonos                     Abono[]
  cargos                     Cargo[]
  inscripciones              Inscripcion[]
  categoriaId                String? // El campo que guarda el ID
  categoria                  Categoria?           @relation(fields: [categoriaId], references: [id]) // La relación
  documentos                 Documento[]
  documentoPendientes        DocumentoPendiente[]
  ventas                     Venta[]
}

model Temporada {
  id               String               @id @default(cuid())
  nombre           String
  fechaInicio      DateTime
  fechaFin         DateTime
  activa           Boolean              @default(false)
  balancePdf       String? // Ruta al PDF de balance
  fechaCierre      DateTime?
  balanceGenerado  Boolean              @default(false)
  abonos           Abono[]
  cargos           Cargo[]
  equipos          Equipo[]
  ingresos         IngresoExterno[]
  inscripciones    Inscripcion[]
  gastos           Gasto[]
  documentos       Documento[]
  precios          TemporadaCategoria[]
  movimientoStocks MovimientoStock[]
  ventas           Venta[]
}

model TemporadaCategoria {
  id          String  @id @default(cuid())
  temporadaId String
  categoriaId String
  costeCuota  Float? // Null = no definido aún
  costeFicha  Float? // Null = no definido aún (solo si hay equipo federado)
  incluyeRopa Boolean @default(false)

  temporada Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@unique([temporadaId, categoriaId])
}

model Inscripcion {
  id          String    @id @default(cuid())
  socioId     String
  temporadaId String
  categoriaId String // Categoría del jugador (calculada por edad)
  equipoId    String? // Null = no federado (solo inscrito en la categoría)
  federado    Boolean   @default(false) // Si el jugador está federado en un equipo
  equipo      Equipo?   @relation(fields: [equipoId], references: [id])
  socio       Socio     @relation(fields: [socioId], references: [id])
  temporada   Temporada @relation(fields: [temporadaId], references: [id])
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  @@unique([socioId, temporadaId])
}

model Cargo {
  id          String      @id @default(cuid())
  monto       Float
  concepto    String
  fecha       DateTime    @default(now())
  socioId     String
  temporadaId String
  abonos      Abono[]
  documentos  Documento[]
  socio       Socio       @relation(fields: [socioId], references: [id])
  temporada   Temporada   @relation(fields: [temporadaId], references: [id])
}

model Abono {
  id             String      @id @default(cuid())
  monto          Float
  metodo         MetodoPago
  estado         EstadoAbono @default(PENDIENTE)
  motivo         String?
  comprobanteUrl String?
  fecha          DateTime    @default(now())
  socioId        String
  temporadaId    String
  aprobadoPorId  String?
  cargoId        String?
  aprobadoPor    User?       @relation("Aprobador", fields: [aprobadoPorId], references: [id])
  cargo          Cargo?      @relation(fields: [cargoId], references: [id])
  socio          Socio       @relation(fields: [socioId], references: [id])
  temporada      Temporada   @relation(fields: [temporadaId], references: [id])
}

model IngresoExterno {
  id          String    @id @default(cuid())
  monto       Float
  fuente      String
  concepto    String
  fecha       DateTime  @default(now())
  temporadaId String
  temporada   Temporada @relation(fields: [temporadaId], references: [id])
}

model Gasto {
  id          String     @id @default(cuid())
  monto       Float
  concepto    String
  categoria   String // Ej: "Arbitrajes", "Material", "Instalaciones"
  metodo      MetodoPago
  fecha       DateTime   @default(now())
  temporadaId String
  temporada   Temporada  @relation(fields: [temporadaId], references: [id])
}

model Log {
  id        String   @id @default(cuid())
  accion    String
  detalles  String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model Evento {
  id        String     @id @default(cuid())
  tipo      TipoEvento @default(PARTIDO)
  fecha     DateTime
  ubicacion String // "Campo Municipal", "Sede Social", etc.

  // Para eventos NO deportivos (Cenas, Asambleas)
  titulo   String?
  detalles String? @db.Text

  // Para PARTIDOS y eventos de EQUIPO
  // Al obligar a tener equipoId, ya tenemos la Categoría vinculada

  esLocal   Boolean  @default(true)
  rival     String?
  equipo    Equipo?  @relation(fields: [equipoId], references: [id])
  equipoId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
}

model Equipo {
  id            String        @id @default(cuid())
  nombre        String
  temporadaId   String
  categoriaId   String
  categoria     Categoria     @relation(fields: [categoriaId], references: [id])
  temporada     Temporada     @relation(fields: [temporadaId], references: [id])
  federado      Boolean       @default(true) // Si false, no se cobra ficha federativa
  cerrado       Boolean       @default(false) // No editable tras cerrar temporada
  partidos      Evento[]
  inscripciones Inscripcion[]

  @@unique([nombre, temporadaId])
}

model Categoria {
  id            String               @id @default(cuid())
  nombre        String               @unique
  equipos       Equipo[]
  socios        Socio[]
  precios       TemporadaCategoria[]
  inscripciones Inscripcion[]
}

model Documento {
  id String @id @default(cuid())

  tipo        TipoDocumento
  filename    String
  storagePath String        @unique
  concepto    String? // Para comprobantes de pago: F+R+E, etc.

  socioId String
  socio   Socio  @relation(fields: [socioId], references: [id])

  temporadaId String
  temporada   Temporada @relation(fields: [temporadaId], references: [id])

  cargoId String?
  cargo   Cargo?  @relation(fields: [cargoId], references: [id])

  subidoPorId String?
  subidoPor   User?   @relation(fields: [subidoPorId], references: [id])

  estado EstadoDocumento @default(PENDIENTE)

  createdAt DateTime @default(now())
}

model DocumentoPendiente {
  id String @id @default(cuid())

  filename String
  tempPath String

  tipoDetectado      TipoDocumento?
  nombreDetectado    String?
  temporadaDetectada String?
  concepto           String? // Para comprobantes: F+R+E, fecha de transacción, etc.

  socioId String?
  socio   Socio?  @relation(fields: [socioId], references: [id])

  estado EstadoProcesamiento @default(SUBIDO)

  error String?

  createdAt DateTime @default(now())
}

enum EstadoProcesamiento {
  SUBIDO
  ANALIZANDO
  MATCH_AUTOMATICO
  REQUIERE_REVISION
  CONFIRMADO
}

enum TipoDocumento {
  DNI
  DR
  DJ
  ER
  AI
  COMPROBANTE_PAGO
}

enum EstadoDocumento {
  PENDIENTE
  VALIDADO
  RECHAZADO
  ORFANO
}

enum Role {
  ADMIN
  CONTABILIDAD
  DIRECTIVA
  COLABORADOR
}

enum UserStatus {
  ACTIVE
  PENDING
  DISABLED
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  COMPENSACION
  CONDONACION
  TARJETA
}

enum EstadoAbono {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoEvento {
  PARTIDO
  TORNEO
  SOCIAL
  REUNION
  OTRO
}

// ========================================
// MODELOS DE TIENDA E INVENTARIO
// ========================================

model Producto {
  id           String       @id @default(cuid())
  nombre       String
  categoria    String // "Camiseta", "Sudaderas", "Chubasqueros", "Llaveros", etc.
  descripcion  String?
  precioVenta  Float // Precio para venta directa
  precioCosto  Float? // Precio al proveedor (para cálculos)
  activoVenta  Boolean      @default(true) // Mostrar en tienda
  activoPedido Boolean      @default(true) // Incluir en pedidos al proveedor
  tipo         TipoProducto @default(ROPA)
  createdAt    DateTime     @default(now())

  tallas ProductoTalla[]
  stock  MovimientoStock[]
  ventas VentaProducto[]

  @@index([categoria])
}

model ProductoTalla {
  id         String @id @default(cuid())
  productoId String
  talla      String // "S", "M", "L", "XL", "Talla 6", "Talla 8", etc.
  stock      Int    @default(0)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, talla])
}

model MovimientoStock {
  id          String         @id @default(cuid())
  productoId  String
  talla       String
  cantidad    Int // Positivo = entrada, Negativo = salida
  tipo        TipoMovimiento // COMPRA, VENTA, ENTREGA, REGALO, AJUSTE
  razon       String? // Para regalar: "Evento X", "Premio Y"
  ventaId     String?
  temporadaId String

  producto  Producto  @relation(fields: [productoId], references: [id])
  temporada Temporada @relation(fields: [temporadaId], references: [id])
  venta     Venta?    @relation(fields: [ventaId], references: [id])

  @@index([productoId])
  @@index([temporadaId])
}

model Venta {
  id            String      @id @default(cuid())
  socioId       String? // Null = venta anónima (visitante)
  tipo          TipoVenta // DIRECTA, ENTREGADA, PLAZOS, FIADO
  estado        EstadoVenta @default(PENDIENTE)
  metodo        MetodoPago? // EFECTIVO, TRANSFERENCIA, TARJETA
  total         Float
  fecha         DateTime    @default(now())
  temporadaId   String
  aprobadoPorId String?
  observaciones String?

  socio       Socio?            @relation(fields: [socioId], references: [id])
  temporada   Temporada         @relation(fields: [temporadaId], references: [id])
  aprobadoPor User?             @relation(fields: [aprobadoPorId], references: [id])
  productos   VentaProducto[]
  movimientos MovimientoStock[]

  @@index([socioId])
  @@index([temporadaId])
  @@index([estado])
}

model VentaProducto {
  id             String @id @default(cuid())
  ventaId        String
  productoId     String
  talla          String
  cantidad       Int
  precioUnitario Float

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([ventaId, productoId, talla])
}

enum TipoProducto {
  ROPA
  COMPLEMENTO
}

enum TipoMovimiento {
  COMPRA
  VENTA
  ENTREGA
  REGALO
  AJUSTE
}

enum TipoVenta {
  DIRECTA // Venta en tienda (efectivo/tarjeta)
  ENTREGADA // Entrega a jugador (incluida en inscripción)
  PLAZOS // Venta a plazos
  FIADO // Queda a deber
}

enum EstadoVenta {
  PENDIENTE
  APROBADA
  RECHAZADA
  COMPLETADA
}
